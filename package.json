{
  "name": "lyrix",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal desktop FLAC player built with Electron and TypeScript",
  "main": "./build/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e/smoke.mjs",
    "test:e2e:full": "npm run build && node tests/e2e/full/index.mjs",
    "test:e2e:visual": "npm run build && node tests/e2e/full/visual.mjs",
    "fixtures:e2e": "node tests/e2e/fixtures/generate.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "electron": "^45.2.1",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "music-metadata": "^12.3.4"
  }
}
